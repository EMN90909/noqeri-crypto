module noqeri.crypto

extern function cryptoRandomFill(output: []u8): bool
extern function cryptoSha256(input: []u8, output: []u8): bool
extern function cryptoBlake3(input: []u8, output: []u8): bool
extern function cryptoHmacSha256(key: []u8, input: []u8, output: []u8): bool
extern function cryptoAesGcm(key: []u8, nonce: []u8, input: []u8, output: []u8): bool

export function cryptoSha256OutputSize(): usize { return 32 as usize }
export function cryptoCanDigest(output: []u8): bool { return len(output) >= 32 as usize }
export function cryptoDigest(input: []u8, output: []u8): bool { if !cryptoCanDigest(output) { return false } return cryptoSha256(input, output) }
export function cryptoBlake3Digest(input: []u8, output: []u8): bool { if !cryptoCanDigest(output) { return false } return cryptoBlake3(input, output) }
export function cryptoHmac(key: []u8, input: []u8, output: []u8): bool { if len(key) == 0 as usize || !cryptoCanDigest(output) { return false } return cryptoHmacSha256(key, input, output) }
export function cryptoEncrypt(key: []u8, nonce: []u8, input: []u8, output: []u8): bool { if len(key) != 16 as usize && len(key) != 24 as usize && len(key) != 32 as usize { return false } if len(nonce) != 12 as usize { return false } return cryptoAesGcm(key, nonce, input, output) }
export function cryptoDigestEqual(left: []u8, right: []u8): bool {
    if len(left) != len(right) { return false }
    let mismatch: int = 0
    let i: usize = 0 as usize
    while i < len(left) {
        if left[i] != right[i] { mismatch = mismatch + 1 }
        i = i + 1 as usize
    }
    return mismatch == 0
}

